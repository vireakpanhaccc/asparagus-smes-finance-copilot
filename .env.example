# Copy to .env and fill in. Never commit .env.

# LLM. Default: Z.ai GLM free tier through its OpenAI-compatible API.
# Get a key at https://z.ai/manage-apikey/apikey-list (Standard key; the *-flash
# models are free, no top-up needed).
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.5-flash
# Tried in order when the main model is busy (comma-separated)
LLM_FALLBACK_MODELS=glm-4.7-flash
# Provider-specific request options (JSON). Z.ai: thinking off cuts latency ~3x.
# Set to empty for providers that do not support it.
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# Required: the API refuses to start without both (no defaults, at least 32 / 16 characters).
# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SECRET=
APPROVAL_TTL_SECONDS=600
# Also put the same value in frontend/.env.local as NEXT_PUBLIC_OWNER_TOKEN=...
OWNER_DEMO_TOKEN=

# Keep true for the competition. Real sending is not implemented.
SANDBOX_MODE=true

# Local dev without Docker uses SQLite; Docker Compose overrides this with Postgres.
DATABASE_URL=sqlite:///./sme_finance.db
